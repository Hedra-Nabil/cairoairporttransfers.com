---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  keywords?: string;
  ogImage?: string;
  type?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title = "Book Cairo Airport Private Transfers & Limousine | CAI",
  description = "Book Cairo airport private transfers & luxury limousine to Giza Pyramids or Downtown. 100% fixed rates, inside Meet & Greet & 24/7 dispatch support.",
  canonicalUrl,
  keywords = "Cairo airport private transfers, Cairo airport private limousine, Cairo airport transfers, Cairo airport limousine, Private Cairo airport transfers, Cairo international airport transfers, Transfer from Cairo airport, Cairo airport taxi, Egypt airports, book Cairo airport transfer, reserve Cairo airport limousine",
  ogImage = "/images/hero-banner.jpg",
  type = "website",
  schema
} = Astro.props;

// Canonical URL generation
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://cairoairportlimousines.com';
let canonical = canonicalUrl || new URL(Astro.url.pathname, `${siteUrl}/`).href;
if (!canonical.endsWith('/')) {
  canonical = `${canonical}/`;
}
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Default Sitewide TaxiService & LimousineService Schema
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": ["TaxiService", "LimousineService"],
  "@id": `${siteUrl}/#service`,
  "name": "Cairo Airport Transfers & Limousine",
  "alternateName": [
    "Cairo Airport Private Transfers",
    "Cairo Airport Private Limousine",
    "Cairo Airport Transfers",
    "Cairo Airport Limousine",
    "Private Cairo Airport Transfers",
    "Cairo International Airport Transfers",
    "Transfer from Cairo Airport"
  ],
  "serviceType": [
    "Cairo Airport Private Transfers",
    "Cairo Airport Private Limousine",
    "Cairo Airport Transfers",
    "Cairo Airport Limousine",
    "Private Airport Chauffeur Service"
  ],
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}/images/logo/logo-brand.png`,
  "image": `${siteUrl}/images/hero-banner.jpg`,
  "telephone": "+201090008888",
  "priceRange": "$$",
  "currenciesAccepted": "USD, EUR, GBP, EGP",
  "paymentAccepted": "Credit Card, Debit Card, Apple Pay, Cash",
  "areaServed": [
    { "@type": "Airport", "name": "Cairo International Airport", "iataCode": "CAI" },
    { "@type": "Airport", "name": "Sphinx International Airport", "iataCode": "SPX" },
    { "@type": "AdministrativeArea", "name": "Cairo" },
    { "@type": "AdministrativeArea", "name": "Giza" },
    { "@type": "AdministrativeArea", "name": "Alexandria" }
  ],
  "description": "Official Cairo airport private transfers and luxury limousine service. Direct hotel pickup, inside terminal Meet & Greet, fixed transparent pricing, and 24/7 dispatch.",
  "keywords": "Cairo airport private transfers, Cairo airport private limousine, Cairo airport transfers, Cairo airport limousine, Private Cairo airport transfers",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Cairo Airport Transfer & Limousine Services",
    "itemListElement": [
      {
        "@type": "OfferCatalog",
        "name": "Airport Transfer Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cairo Airport Private Transfers",
              "description": "Direct private airport taxi transfer from CAI terminals to hotels"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cairo Airport Private Limousine",
              "description": "Chauffeur-driven executive VIP limousine from Cairo Airport"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cairo International Airport Transfers",
              "description": "Fixed-rate door-to-door passenger shuttles across Cairo and Giza"
            }
          }
        ]
      }
    ]
  },
  "provider": {
    "@type": "LocalBusiness",
    "name": "Cairo Airport Transfers Dispatch Co.",
    "telephone": "+201090008888",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cairo International Airport Terminal 3 Access Rd",
      "addressLocality": "Heliopolis",
      "addressRegion": "Cairo",
      "postalCode": "11776",
      "addressCountry": "EG"
    }
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="Cairo Airport Transfers" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />
    {schema && (
      <script 
        type="application/ld+json" 
        set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])} 
      />
    )}

    <meta name="generator" content={Astro.generator} />

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
        color: #1e293b;
        background-color: #ffffff;
      }
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f1f5f9;
      }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-amber-100 selection:text-amber-900">
    <slot />
  </body>
</html>
