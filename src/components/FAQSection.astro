---
const faqs = [
  {
    q: "Where will I meet my driver at Cairo International Airport?",
    a: "Your chauffeur will wait inside the public arrivals hall of your designated arrival terminal (Terminal 1, Terminal 2, or Terminal 3), immediately after you pass through customs and baggage claim. They will hold an official greeting sign clearly displaying your name."
  },
  {
    q: "What happens if my flight to Cairo is delayed?",
    a: "No need to worry! We track your flight in real time using the flight number provided during booking. Your pickup time is automatically synchronized with your actual landing time. Your complimentary 60-minute wait time begins only when your flight actually lands."
  },
  {
    q: "Are the prices listed per person or per vehicle?",
    a: "All our prices are 100% per vehicle, not per passenger. The price shown for your selected vehicle covers your entire party up to the vehicle's maximum passenger and luggage capacity."
  },
  {
    q: "Can my driver assist with getting a local Egyptian SIM card or ATM?",
    a: "Yes, absolutely! The main arrivals halls have official telecom booths (Vodafone, Orange, e&, WE) and bank ATMs. Your driver will gladly wait for you while you purchase a local SIM card or exchange currency before escorting you to the vehicle."
  },
  {
    q: "How does free cancellation work?",
    a: "You can cancel or modify your transfer reservation free of charge up to 24 hours prior to your scheduled pickup time with a 100% full refund, no questions asked. Simply contact our support team or WhatsApp dispatch."
  }
];
---

<section id="faqs" class="py-20 md:py-24 bg-white border-b border-slate-100">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-14">
      <div class="text-xs font-black tracking-widest text-indigo-600 uppercase mb-2">
        HELP & SUPPORT
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-slate-500 text-sm sm:text-base mt-2">
        Clear, transparent answers about terminal meeting points, flight delays, currencies, and cancellation policies.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((item, index) => (
        <details class="group bg-slate-50/50 hover:bg-white rounded-2xl border border-slate-100 shadow-sm transition-all open:bg-white open:border-slate-200 open:shadow-md">
          <summary class="p-6 cursor-pointer list-none flex items-center justify-between font-bold text-slate-900 hover:text-indigo-600 transition select-none">
            <span class="text-base sm:text-lg font-bold pr-4">{item.q}</span>
            <div class="w-8 h-8 rounded-full bg-slate-100 group-open:bg-amber-400 text-slate-600 group-open:text-slate-950 flex items-center justify-center transition-all group-open:rotate-180 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 pt-1 border-t border-slate-100 text-sm text-slate-600 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a 
        href="/faq" 
        class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-slate-200 hover:border-slate-300 text-slate-800 font-bold text-xs rounded-xl shadow-xs hover:shadow transition"
      >
        <span>View all 20+ Frequently Asked Questions</span>
        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
