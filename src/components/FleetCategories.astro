---
const vehicleTypes = [
  {
    id: "taxi",
    title: "Private Taxi",
    subtitle: "Ideal for solo travelers or couples with luggage",
    capacity: "Up to 3 passengers • 2 bags",
    tag: "Most Popular",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />`
  },
  {
    id: "minivan",
    title: "Private Minivan",
    subtitle: "Spacious comfort for families and golf equipment",
    capacity: "Up to 7 passengers • 6 bags",
    tag: "Family Choice",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    id: "executive",
    title: "Executive / VIP",
    subtitle: "Luxury Mercedes-Benz sedans with Wi-Fi & water",
    capacity: "Up to 3 passengers • 3 bags",
    tag: "Premium",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`
  },
  {
    id: "minibus",
    title: "Airport Shuttle & Minibus",
    subtitle: "High capacity transport for large tour groups",
    capacity: "Up to 16 passengers • 16 bags",
    tag: "Group Saver",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`
  }
];
---

<section id="fleet" class="py-20 md:py-24 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Info Column -->
      <div class="lg:col-span-5 space-y-6">
        <div class="text-xs font-black tracking-widest text-indigo-600 uppercase">
          MODERN & AIR-CONDITIONED FLEET
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Vehicle Classes & Capacities
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From solo business travelers and couples to large families and tour groups, select the ideal vehicle category tailored precisely to your passenger count and luggage requirements.
        </p>
        
        <ul class="space-y-3 text-sm text-slate-700 font-medium">
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Air-conditioned, modern vehicles fully inspected
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Professional English-speaking licensed chauffeurs
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Free flight monitoring & guaranteed Meet & Greet
          </li>
        </ul>

        <div class="pt-2">
          <a 
            href="/fleet" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-sm rounded-xl shadow-sm hover:shadow transition-all transform hover:-translate-y-0.5"
          >
            Explore Full Fleet & Luggage Guide
          </a>
        </div>
      </div>

      <!-- Right 2x2 Categories Grid -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {vehicleTypes.map((item) => (
          <a 
            href="/fleet"
            class="p-6 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-slate-200 hover:shadow-lg transition-all duration-200 flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
                </div>
                <span class="text-[10px] font-bold text-indigo-700 bg-indigo-100/70 px-2.5 py-1 rounded-md">
                  {item.tag}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
                {item.title}
              </h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                {item.subtitle}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-700">
                {item.capacity}
              </span>
              <div class="w-7 h-7 rounded-full bg-slate-200/80 group-hover:bg-amber-400 text-slate-700 group-hover:text-slate-950 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>
