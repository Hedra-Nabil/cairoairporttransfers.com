---
import { fleetVehicles } from '../data/fleet';

const categoryIcons: Record<string, string> = {
  "private-taxi": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />`,
  "private-minivan": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  "executive-vip": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`,
  "airport-minibus": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`
};
---

<section id="fleet" class="py-20 md:py-24 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Info Column -->
      <div class="lg:col-span-5 space-y-6">
        <div class="text-xs font-black tracking-widest text-indigo-600 uppercase">
          MODERN & AIR-CONDITIONED FLEET
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Vehicle Classes & Capacities
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From solo business travelers and couples to large families and tour groups, select the ideal vehicle category tailored precisely to your passenger count and luggage requirements.
        </p>
        
        <ul class="space-y-3 text-sm text-slate-700 font-medium">
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Air-conditioned, modern vehicles fully inspected
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Professional English-speaking licensed chauffeurs
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Free flight monitoring & driver meets outside with sign
          </li>
          <li class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-bold">✓</span>
            Transparent fixed rates with zero hidden airport surcharges
          </li>
        </ul>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a 
            href="/fleet" 
            class="inline-flex items-center justify-center px-6 py-3.5 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-sm rounded-xl shadow-sm hover:shadow transition-all transform hover:-translate-y-0.5"
          >
            Explore Full Fleet & Luggage Guide
          </a>
        </div>
      </div>

      <!-- Right 2x2 Categories Grid -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {fleetVehicles.map((item) => (
          <a 
            href={`/fleet/${item.slug}`}
            class="p-5 sm:p-6 rounded-2xl border border-slate-200/80 bg-slate-50/60 hover:bg-white hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative overflow-hidden"
          >
            <div>
              <!-- Top Row: Icon Badge, Category Tag & Price -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={categoryIcons[item.slug]}></svg>
                  </div>
                  <span class="text-[10px] font-bold text-indigo-700 bg-indigo-100/70 px-2 py-0.5 rounded-md uppercase tracking-wider">
                    {item.tag}
                  </span>
                </div>

                <div class="text-right">
                  <span class="text-[10px] text-slate-400 block uppercase font-bold leading-none">From</span>
                  <span class="text-sm font-black text-slate-900 leading-none">${item.samplePriceCairo}</span>
                </div>
              </div>

              <!-- Vehicle Realistic Studio Render Image with SEO Alt -->
              <div class="relative w-full h-32 sm:h-36 my-2 flex items-center justify-center overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.alt}
                  title={item.alt}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-md"
                />
              </div>

              <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-indigo-600 transition">
                {item.title}
              </h3>
              
              <p class="text-xs text-slate-500 mt-1 leading-relaxed line-clamp-2">
                {item.subtitle}
              </p>

              <!-- Example Brands/Models Pill -->
              <div class="mt-2.5 flex items-center gap-1 text-[11px] text-slate-600">
                <span class="text-slate-400 font-medium">Models:</span>
                <span class="font-semibold text-slate-700 truncate">{item.models.slice(0, 2).join(", ")} or similar</span>
              </div>
            </div>

            <!-- Bottom Capacity & Arrow CTA -->
            <div class="mt-5 pt-3 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-700 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                {item.capacity}
              </span>

              <div class="flex items-center gap-1.5 text-xs font-bold text-slate-700 group-hover:text-slate-950">
                <span class="hidden sm:inline text-[11px] text-indigo-600 font-semibold group-hover:underline">Details</span>
                <div class="w-7 h-7 rounded-full bg-slate-200/80 group-hover:bg-amber-400 text-slate-700 group-hover:text-slate-950 flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>
