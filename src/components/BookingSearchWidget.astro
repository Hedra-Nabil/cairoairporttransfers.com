---
// Official Egypt Limo Booking Engine Integration Component
interface Props {
  customActionUrl?: string;
  isStandalone?: boolean;
  defaultDropoff?: string;
  pickup?: string;
  source?: string;
  language?: string;
}

const { 
  pickup = "Cairo International Airport",
  source = "cairoairporttransfers",
  language = "en",
  defaultDropoff = "",
  customActionUrl = "/transfers",
  isStandalone = false
} = Astro.props;
---

<div id="search-booking" class="w-full max-w-5xl mx-auto bg-white rounded-3xl shadow-2xl border border-slate-100 p-2 sm:p-4 md:p-6 relative z-20 overflow-hidden">
  <!-- Egypt Limo Official Booking Container -->
  <div id="egyptlimo-booking" class="w-full min-h-[640px] rounded-2xl overflow-hidden bg-white">
    <!-- Loading State Placeholder (replaced automatically when iframe loads) -->
    <div id="booking-loading-skeleton" class="flex flex-col items-center justify-center py-28 text-slate-400 space-y-4">
      <div class="w-10 h-10 border-4 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
      <div class="text-center">
        <p class="text-sm font-bold text-slate-700">Connecting to Egypt Limo Booking System...</p>
        <p class="text-xs text-slate-400 mt-1">Real-time availability, fixed rates & instant confirmation</p>
      </div>
    </div>
  </div>

  <!-- Egypt Limo Widget Script -->
  <script
    src="https://booking.egyptlimo.com/widget.js"
    data-target="egyptlimo-booking"
    data-language={language}
    data-pickup={pickup}
    data-source={source}
    defer
  ></script>
</div>

<script>
  // Listen for Egypt Limo booking widget lifecycle events
  window.addEventListener('egyptlimo:booking', (event: any) => {
    const data = event.detail;
    if (data?.type === 'egyptlimo:booking:ready') {
      console.log('[Egypt Limo Widget] Booking engine ready.');
    }
    if (data?.type === 'egyptlimo:booking:resize') {
      console.log('[Egypt Limo Widget] Resized to:', data.height);
    }
  });
</script>
