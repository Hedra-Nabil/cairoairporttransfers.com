---
const steps = [
  {
    step: "01",
    title: "Select your transfer",
    desc: "Choose pickup terminal, destination hotel or area, date, and select the ideal vehicle type for your group and luggage."
  },
  {
    step: "02",
    title: "Enter flight & hotel details",
    desc: "Provide your flight number for live delay tracking and your hotel address. Complete secure, instant cashless checkout."
  },
  {
    step: "03",
    title: "Meet your driver at arrivals",
    desc: "Receive your digital confirmation voucher. Your driver greets you inside the terminal with a name board and escorts you to the car."
  }
];
---

<section id="how-it-works" class="py-20 md:py-24 bg-slate-50/50 border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs font-black tracking-widest text-indigo-600 uppercase mb-2">
        SEAMLESS PROCESS
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        How Your Airport Pickup Works
      </h2>
      <p class="text-slate-500 text-sm sm:text-base mt-2">
        From online reservation to hotel check-in, our streamlined arrival process ensures zero haggling and complete peace of mind.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((item, index) => (
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition flex flex-col justify-between relative group">
          
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-4xl font-black text-indigo-200 group-hover:text-indigo-600 transition-colors">
                {item.step}
              </span>
              <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-xs">
                ✓
              </div>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-indigo-600 transition">
              {item.title}
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center text-xs font-bold text-amber-600">
            <span>Quick & Guaranteed</span>
          </div>

        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a 
        href="/how-it-works" 
        class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 hover:text-indigo-800 transition group"
      >
        <span>Learn more about flight delay guarantees & driver meet protocols</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
