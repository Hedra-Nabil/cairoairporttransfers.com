---
const destinations = [
  {
    name: "Downtown Cairo & Tahrir",
    tag: "City Center",
    desc: "Home to the historic Egyptian Museum, Tahrir Square, vibrant markets, and luxury Nile-view hotels in Zamalek and Garden City.",
    time: "35 - 45 mins",
    distance: "21 km",
    fromPrice: "$24",
    highlights: ["Egyptian Museum", "Khan El-Khalili", "Nile Felucca Rides"],
    image: "/images/cairo-downtown.jpg"
  },
  {
    name: "Giza Pyramids & Sphinx",
    tag: "Ancient Wonder",
    desc: "Marvel at the world-famous Great Pyramids of Khufu, Khafre, Menkaure, the Great Sphinx, and the state-of-the-art Grand Egyptian Museum (GEM).",
    time: "50 - 65 mins",
    distance: "38 km",
    fromPrice: "$32",
    highlights: ["Grand Egyptian Museum", "Giza Plateau", "Marriott Mena House"],
    image: "/images/giza-pyramids.jpg"
  },
  {
    name: "New Cairo & 5th Settlement",
    tag: "Modern Capital",
    desc: "Cairo's premier modern district featuring upscale dining, Cairo Festival City, Dusit Thani, and seamless transit to the New Administrative Capital.",
    time: "20 - 30 mins",
    distance: "18 km",
    fromPrice: "$22",
    highlights: ["Cairo Festival City", "Point 90 Mall", "5th Settlement"],
    image: "/images/cairo-downtown.jpg"
  },
  {
    name: "Alexandria & Med Coast",
    tag: "Seaside City",
    desc: "Egypt's historical Mediterranean jewel boasting the Qaitbay Citadel, Stanley Bridge, Montaza Palace gardens, and the modern Bibliotheca.",
    time: "2.5 - 3 hours",
    distance: "225 km",
    fromPrice: "$89",
    highlights: ["Citadel of Qaitbay", "Bibliotheca Alexandrina", "Corniche"],
    image: "/images/alexandria-coast.jpg"
  }
];
---

<section id="destinations" class="py-16 md:py-24 bg-slate-50 border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="text-xs font-black tracking-widest text-indigo-600 uppercase mb-2">
        EXPLORE EGYPT
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Places to travel to near Cairo International Airport
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2">
        Whether you are heading directly to historic landmarks or continuing onward across Egypt, our private drivers ensure safe, air-conditioned transit.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {destinations.map((place) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-slate-300 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group">
          
          <div class="relative h-44 overflow-hidden bg-slate-100">
            <img 
              src={place.image} 
              alt={place.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider bg-white/95 text-slate-900 rounded-md">
              {place.tag}
            </span>
            <span class="absolute bottom-3 left-3 text-xs font-semibold text-white flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {place.time} ({place.distance})
            </span>
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition">
                {place.name}
              </h3>
              <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">
                {place.desc}
              </p>

              <!-- Highlights tags -->
              <div class="mt-4 flex flex-wrap gap-1.5">
                {place.highlights.map((tag) => (
                  <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none">From</span>
                <span class="text-xl font-black text-slate-900">{place.fromPrice}</span>
              </div>
              <a 
                href="#search-booking" 
                class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 group/link"
              >
                <span>Book transfer</span>
                <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
