---
import BookingSearchWidget from './BookingSearchWidget.astro';
---

<section class="relative bg-slate-950 pt-12 pb-24 md:pb-32 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-banner.jpg" 
      alt="Cairo International Airport Transfers Fleet at Giza Pyramids" 
      class="w-full h-full object-cover object-center opacity-45 scale-105 transform motion-safe:transition-transform motion-safe:duration-1000"
      loading="eager"
    />
    <!-- Atmospheric Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-900/40"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-transparent to-slate-950/80"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto flex flex-col items-center text-center">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-600/90 text-indigo-100 text-xs font-extrabold uppercase tracking-widest mb-6 shadow-md shadow-indigo-900/40 backdrop-blur-sm border border-indigo-400/30">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      AIRPORT TRANSFERS
    </div>

    <!-- Main Hero Title -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight uppercase max-w-5xl leading-tight sm:leading-none mb-6 drop-shadow-md">
      CAIRO INTERNATIONAL <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-amber-300">AIRPORT TRANSFERS</span>
    </h1>

    <!-- Subtitle / Highlights -->
    <p class="text-slate-300 text-sm sm:text-base lg:text-lg max-w-2xl font-normal mb-10 leading-relaxed drop-shadow">
      Official private taxi, VIP minivans and shuttle transfers from Cairo Airport (CAI) directly to your hotel. Fixed fares, free flight tracking, and personal Meet & Greet included.
    </p>

    <!-- Floating Search Engine / Booking Widget -->
    <div class="w-full mt-2">
      <BookingSearchWidget />
    </div>

    <!-- Trust Badges Bar under the Search -->
    <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-300 font-medium">
      <div class="flex items-center gap-1.5">
        <div class="flex text-amber-400">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <span class="text-white font-bold">4.9 / 5</span>
        <span class="text-slate-400">(15,800+ Cairo transfers)</span>
      </div>
      <span class="hidden sm:inline text-slate-600">•</span>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <span>No Hidden Costs</span>
      </div>
      <span class="hidden sm:inline text-slate-600">•</span>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Free 60 Mins Wait at Airport</span>
      </div>
    </div>

  </div>
</section>
