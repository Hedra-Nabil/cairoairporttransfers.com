---

<section class="py-12 md:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#141238] rounded-3xl p-8 sm:p-14 text-white shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 border border-indigo-900/60">
      
      <!-- Ambient Glows -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl text-center md:text-left space-y-3">
        <span class="inline-block px-3 py-1 rounded-md bg-amber-400/20 text-amber-400 text-xs font-black uppercase tracking-wider">
          READY TO TRAVEL?
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
          Book a transfer from Cairo International Airport
        </h2>
        <p class="text-slate-300 text-sm sm:text-base">
          Experience smooth, premium airport transportation with fixed rates, vetted drivers, and round-the-clock dispatch assistance.
        </p>
      </div>

      <div class="relative z-10 flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto">
        <a 
          href="#search-booking" 
          class="w-full sm:w-auto px-8 py-4 bg-amber-400 hover:bg-amber-500 text-slate-950 font-black text-sm rounded-xl shadow-lg transition transform hover:-translate-y-0.5 text-center"
        >
          Book transfer now
        </a>
        <a 
          href="https://wa.me/201090008888" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-4 border border-slate-600 hover:border-white text-white font-bold text-sm rounded-xl transition hover:bg-white/10 text-center flex items-center justify-center gap-2"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>

    </div>
  </div>
</section>
