---
interface TransferRoute {
  id: string;
  name: string;
  destination: string;
  badge: string;
  duration: string;
  distance: string;
  vehicle: string;
  pax: number;
  luggage: number;
  price: string;
  currency: string;
  image: string;
}

const routes: TransferRoute[] = [
  {
    id: "downtown",
    name: "Cairo City Centre",
    destination: "Downtown Cairo / Tahrir Square / Zamalek",
    badge: "MOST POPULAR",
    duration: "35 - 45 mins",
    distance: "21 km",
    vehicle: "Standard Sedan / Minivan",
    pax: 3,
    luggage: 3,
    price: "24",
    currency: "$",
    image: "/images/cairo-downtown.jpg"
  },
  {
    id: "giza",
    name: "Giza Pyramids Area",
    destination: "Mena House, Giza Plateau & Sphinx Hotels",
    badge: "TOP SIGHT",
    duration: "50 - 65 mins",
    distance: "38 km",
    vehicle: "Private Sedan / SUV",
    pax: 3,
    luggage: 3,
    price: "32",
    currency: "$",
    image: "/images/giza-pyramids.jpg"
  },
  {
    id: "new-cairo",
    name: "New Cairo / Tagamoa",
    destination: "5th Settlement, Dusit Thani, Kempinski",
    badge: "FAST ROUTE",
    duration: "20 - 30 mins",
    distance: "18 km",
    vehicle: "Comfort Sedan / Minivan",
    pax: 3,
    luggage: 3,
    price: "22",
    currency: "$",
    image: "/images/cairo-downtown.jpg"
  },
  {
    id: "alexandria",
    name: "Alexandria City & Coast",
    destination: "Corniche, Mediterranean Hotels & Port",
    badge: "INTERCITY",
    duration: "2.5 - 3 hours",
    distance: "225 km",
    vehicle: "VIP Minivan / Mercedes",
    pax: 6,
    luggage: 6,
    price: "89",
    currency: "$",
    image: "/images/alexandria-coast.jpg"
  }
];
---

<section id="popular-transfers" class="py-16 md:py-24 bg-slate-50 border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <div class="text-xs font-black tracking-widest text-indigo-600 uppercase mb-2">
          FAVORITE TRANSFERS
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Popular transfers from Cairo International Airport
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl">
          Fixed-price private transfers with guaranteed meet and greet at Terminal 1, 2, or 3 arrivals halls.
        </p>
      </div>

      <a 
        href="#destinations" 
        class="inline-flex items-center gap-1.5 text-sm font-bold text-indigo-600 hover:text-indigo-800 transition group whitespace-nowrap"
      >
        <span>View all Cairo routes</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Routes Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {routes.map((route) => (
        <div class="bg-white rounded-2xl border border-slate-200/90 hover:border-slate-300 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
          
          <!-- Card Image & Badge -->
          <div class="relative h-44 overflow-hidden bg-slate-100">
            <img 
              src={route.image} 
              alt={route.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            
            <div class="absolute top-3 left-3">
              <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-wider bg-white/95 text-slate-900 rounded-md shadow-sm">
                {route.badge}
              </span>
            </div>

            <div class="absolute bottom-3 left-3 right-3 flex justify-between items-end text-white">
              <span class="text-xs font-semibold flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                {route.duration}
              </span>
              <span class="text-xs text-slate-300">{route.distance}</span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition">
                {route.name}
              </h3>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                {route.destination}
              </p>

              <!-- Vehicle specifications -->
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  <span>Max {route.pax} Pax</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                  <span>{route.luggage} Bags</span>
                </div>
              </div>
            </div>

            <!-- Price and CTA -->
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none">Starting from</span>
                <span class="text-2xl font-black text-slate-900">
                  {route.currency}{route.price}
                </span>
                <span class="text-[10px] text-slate-500">/ vehicle</span>
              </div>

              <a 
                href="#search-booking" 
                class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-sm hover:shadow transition flex items-center gap-1 group/btn"
              >
                <span>Book</span>
                <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
