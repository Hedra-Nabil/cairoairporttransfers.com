---
---

<header class="w-full bg-white border-b border-slate-100 sticky top-0 z-50">
  <!-- Top Support Bar -->
  <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-4">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
          </svg>
          <span class="font-medium">24/7 Cairo Dispatch:</span>
          <a href="tel:+201090008888" class="text-white hover:text-amber-400 font-semibold transition">+20 (10) 9000-8888</a>
        </span>
        <span class="hidden md:inline-block text-slate-600">|</span>
        <span class="hidden md:flex items-center gap-1 text-slate-400">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Flight delay tracking included
        </span>
      </div>

      <div class="flex items-center space-x-4">
        <!-- Currency Dropdown -->
        <div class="flex items-center gap-1 text-slate-300 hover:text-white cursor-pointer transition">
          <span class="font-semibold text-white">USD ($)</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
        <span class="text-slate-600">|</span>
        <!-- Language Selector -->
        <div class="flex items-center gap-1.5 text-slate-300 hover:text-white cursor-pointer transition">
          <span class="inline-block w-4 h-3 bg-red-600 rounded-xs overflow-hidden relative border border-slate-600">
            <span class="absolute inset-0 bg-gradient-to-b from-red-600 via-white to-black"></span>
          </span>
          <span class="font-medium">English</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-[#141238] via-[#1e1b4b] to-[#4338ca] flex items-center justify-center shadow-md shadow-indigo-950/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-xl tracking-tight text-slate-900 leading-none flex items-center gap-1">
            CAIRO<span class="text-amber-500 font-black">TRANSFERS</span>
          </span>
          <span class="text-[10px] tracking-wider font-semibold uppercase text-slate-400 mt-1">
            Airport Taxi & Private Shuttles
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-8 text-sm font-semibold text-slate-700">
        <a href="#popular-transfers" class="hover:text-amber-600 transition">Popular Transfers</a>
        <a href="#fleet" class="hover:text-amber-600 transition">Our Fleet</a>
        <a href="#destinations" class="hover:text-amber-600 transition">Destinations</a>
        <a href="#how-it-works" class="hover:text-amber-600 transition">How It Works</a>
        <a href="#faqs" class="hover:text-amber-600 transition">Help & FAQs</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="#quick-quote" 
          class="px-4 py-2.5 text-sm font-semibold text-slate-700 hover:text-slate-900 border border-slate-200 rounded-lg hover:border-slate-300 hover:bg-slate-50 transition shadow-sm"
        >
          Manage Booking
        </a>
        <a 
          href="#search-booking" 
          class="px-5 py-2.5 text-sm font-bold text-slate-950 bg-amber-400 hover:bg-amber-500 rounded-lg transition shadow-sm hover:shadow flex items-center gap-1.5"
        >
          <span>Book Now</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        aria-label="Toggle Navigation"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white px-4 py-4 space-y-3">
    <a href="#popular-transfers" class="block py-2 text-sm font-semibold text-slate-800 hover:text-amber-600">Popular Transfers</a>
    <a href="#fleet" class="block py-2 text-sm font-semibold text-slate-800 hover:text-amber-600">Our Fleet</a>
    <a href="#destinations" class="block py-2 text-sm font-semibold text-slate-800 hover:text-amber-600">Destinations</a>
    <a href="#how-it-works" class="block py-2 text-sm font-semibold text-slate-800 hover:text-amber-600">How It Works</a>
    <a href="#faqs" class="block py-2 text-sm font-semibold text-slate-800 hover:text-amber-600">Help & FAQs</a>
    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a href="#search-booking" class="w-full text-center py-2.5 text-sm font-bold text-slate-950 bg-amber-400 rounded-lg">Book Transfer</a>
      <a href="#quick-quote" class="w-full text-center py-2.5 text-sm font-semibold text-slate-700 border border-slate-200 rounded-lg">Manage Booking</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
