---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PopularTransfers from '../components/PopularTransfers.astro';
import FleetCategories from '../components/FleetCategories.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AirportOverview from '../components/AirportOverview.astro';
import PickupAndBookingGuides from '../components/PickupAndBookingGuides.astro';
import ServiceFeatures from '../components/ServiceFeatures.astro';
import InformationAccordions from '../components/InformationAccordions.astro';
import FAQSection from '../components/FAQSection.astro';
import PreFooterCTA from '../components/PreFooterCTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const siteUrl = "https://cairoairportlimousines.com";
const pageTitle = "Cairo Airport Limousine | Official Airport Transfers & Chauffeur CAI";
const pageDesc = "Cairo Airport Limousine: Pre-book private airport transfers from CAI directly to your hotel. Enjoy fixed rates, free flight tracking, and 24/7 support.";

// Rich JSON-LD Schemas (BreadcrumbList, HowTo & FAQPage; Master TaxiService schema in Layout)
const homeSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Book Cairo Airport Limousine & Meet Your Chauffeur",
    "description": "Step-by-step guide to reserving private airport transfers from Cairo International Airport (CAI) and meeting your chauffeur curbside outside the arrivals exit.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Select Vehicle & Destination",
        "text": "Choose your sedan, family minivan, executive VIP Mercedes, or minibus online, entering your flight number and destination hotel or address in Cairo or Giza."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Live Flight Tracking & Radar Sync",
        "text": "Our 24/7 CAI flight dispatch monitors your landing time automatically. Driver pickup times synchronize with delays or early arrivals with 60 minutes free wait time."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Clear Immigration & Customs",
        "text": "Disembark at Terminal 1, 2, or 3, stamp your visa, collect luggage from the baggage carousel, and clear the customs inspection."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Meet Chauffeur Outside Arrivals Exit",
        "text": "Step outside the glass exit doors where your licensed driver is holding a personalized greeting board with your name."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Door-to-Door Hotel Drop-off",
        "text": "Relax in air-conditioned comfort as your chauffeur transports you via direct expressways directly to your hotel entrance curbside."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Where will I meet my driver at Cairo International Airport?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your chauffeur will wait outside the arrival exit doors of your designated terminal (Terminal 1, Terminal 2, or Terminal 3), immediately after you pass through customs and baggage claim. They will hold an official greeting sign clearly displaying your name."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if my flight to Cairo is delayed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No need to worry! We track your flight in real time using the flight number provided during booking. Your pickup time is automatically synchronized with your actual landing time. Your complimentary 60-minute wait time begins only when your flight actually lands."
        }
      },
      {
        "@type": "Question",
        "name": "Are the prices listed per person or per vehicle?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All our prices are 100% per vehicle, not per passenger. The price shown for your selected vehicle covers your entire party up to the vehicle's maximum passenger and luggage capacity."
        }
      },
      {
        "@type": "Question",
        "name": "Can my driver assist with currency exchange or using the airport ATM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, absolutely! The arrivals halls have official 24/7 bank branches (National Bank of Egypt, Banque Misr) and ATMs. Your driver will gladly wait for you while you exchange currency or withdraw Egyptian Pounds (EGP) before escorting you to your vehicle."
        }
      },
      {
        "@type": "Question",
        "name": "How does free cancellation work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can cancel or modify your transfer reservation free of charge up to 24 hours prior to your scheduled pickup time with a 100% full refund, no questions asked. Simply contact our support team or WhatsApp dispatch."
        }
      }
    ]
  }
];
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={`${siteUrl}/`}
  schema={homeSchemas}
  preloadImage="/images/hero-banner.webp"
>
  <!-- Global Navigation Header -->
  <Header />

  <main class="space-y-0">
    <!-- 1. Hero Banner with Integrated Search Engine & Consolidated Trust Strip -->
    <Hero />

    <!-- 2. Airport Overview & Terminals Passenger Guide -->
    <AirportOverview />

    <!-- 3. Popular Hotel & City Transfers (Programmatic Routes Linkage) -->
    <PopularTransfers />

    <!-- 4. Step-by-Step Terminal Arrival & Booking Guides -->
    <PickupAndBookingGuides />

    <!-- 5. Vehicle Classes & Capacities (Fleet Guide) -->
    <FleetCategories />

    <!-- 6. Service Guarantees & Features Checklist -->
    <ServiceFeatures />

    <!-- 7. How Your Airport Pickup Works (3 Simple Steps) -->
    <HowItWorks />

    <!-- 8. Informational Accordions (Baggage Guidelines, Terminal Meeting Points, Departure Times) -->
    <InformationAccordions />

    <!-- 9. Frequently Asked Questions (Structured FAQ Accordion) -->
    <FAQSection />

    <!-- 10. Pre-Footer Call to Action Banner -->
    <PreFooterCTA />
  </main>

  <!-- Global Footer with Silo Link Architecture -->
  <Footer />

  <!-- Instant 24/7 WhatsApp Concierge Button -->
  <WhatsAppFloat />
</Layout>
