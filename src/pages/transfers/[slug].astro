---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookingSearchWidget from '../../components/BookingSearchWidget.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { transferRoutes, type TransferRouteData } from '../../data/routes';
import { getRoutePrice } from '../../utils/prices';

export async function getStaticPaths() {
  return transferRoutes.map((route) => ({
    params: { slug: route.slug },
    props: { route },
  }));
}

interface Props {
  route: TransferRouteData;
}

const { route } = Astro.props;
const cachedPricing = getRoutePrice(route.slug, route.startingPriceUSD);

const siteUrl = "https://cairoairportlimousines.com";
const pageUrl = `${siteUrl}/transfers/${route.slug}/`;

// Dynamic Advanced Structured Data (JSON-LD) for Maximum SERP Performance
const routeSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "TaxiService",
    "@id": `${pageUrl}#service`,
    "name": `${route.heroHeadline} - Cairo Airport Limousine`,
    "alternateName": [
      `Transfer from Cairo Airport to ${route.destinationName}`,
      `Cairo Airport Private Transfers to ${route.destinationName}`,
      `Cairo International Airport to ${route.destinationName} Limousine`
    ],
    "serviceType": [
      "Airport Transfer",
      "Cairo Airport Limousine",
      "Cairo Airport Private Transfers",
      "Private Chauffeur Service"
    ],
    "description": route.metaDescription,
    "provider": {
      "@type": "LocalBusiness",
      "name": "Cairo Airport Limousine Dispatch Co.",
      "image": `${siteUrl}/images/hero-banner.jpg`,
      "priceRange": "$$",
      "telephone": "+201094066018",
      "url": `${siteUrl}/`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Cairo International Airport Terminal 3 Access Rd",
        "addressLocality": "Heliopolis",
        "addressRegion": "Cairo",
        "postalCode": "11776",
        "addressCountry": "EG"
      }
    },
    "areaServed": [
      {
        "@type": "Airport",
        "name": "Cairo International Airport",
        "iataCode": "CAI",
        "icaoCode": "HECA",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 30.1219,
          "longitude": 31.4056
        }
      },
      {
        "@type": "Place",
        "name": route.destinationName,
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": route.geoCoordinates.lat,
          "longitude": route.geoCoordinates.lng
        }
      }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "348",
      "bestRating": "5",
      "worstRating": "1"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Standard Sedan Transfer",
        "price": `${route.pricing.sedan}`,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "description": "Private air-conditioned sedan for up to 3 passengers with 2 suitcases."
      },
      {
        "@type": "Offer",
        "name": "Private Minivan Transfer",
        "price": `${route.pricing.minivan}`,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "description": "Family minivan for up to 7 passengers with generous luggage capacity."
      },
      {
        "@type": "Offer",
        "name": "Executive VIP Limousine Transfer",
        "price": `${route.pricing.executive}`,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "description": "Chauffeur-driven Mercedes E-Class with Wi-Fi, bottled water, and VIP meet outside."
      },
      {
        "@type": "Offer",
        "name": "Group Minibus Transfer",
        "price": `${route.pricing.minibus}`,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01",
        "description": "Private passenger minibus for up to 16 passengers and luggage."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": `How to Book and Meet Your Driver for Cairo Airport to ${route.destinationName} Transfer`,
    "description": `Comprehensive step-by-step instructions for booking and meeting your private chauffeur at Cairo International Airport (CAI) for direct hotel transfer to ${route.destinationName}.`,
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Reserve Online with Flight Details",
        "text": `Choose your preferred vehicle (Sedan, Minivan, or Executive VIP) and enter your arrival flight number and drop-off hotel in ${route.destinationName}.`
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Flight Delay Tracking Synchronization",
        "text": "Our dispatch team monitors your flight on live radar. If your flight lands early or experiences delays, your chauffeur's arrival is automatically updated with 60 minutes free wait time."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Clear Customs & Baggage Reclaim",
        "text": "Disembark at CAI Terminal 1, 2, or 3, complete passport control, collect your baggage, and pass customs screening."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Meet Your Chauffeur Outside Arrival Doors",
        "text": "Step outside the sliding arrival glass exit doors into the greeting lane. Your driver will be waiting holding a clear board displaying your name."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": `Direct Expressway Transit to ${route.destinationName}`,
        "text": `Your chauffeur assists with your luggage and drives you via ${route.expressway} directly to your hotel or private residence with zero extra tolls or parking fees.`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Place",
    "name": route.destinationName,
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": route.geoCoordinates.lat,
      "longitude": route.geoCoordinates.lng
    },
    "containedInPlace": {
      "@type": "Country",
      "name": "Egypt"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Transfers",
        "item": `${siteUrl}/transfers/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": route.destinationName,
        "item": pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": route.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<Layout 
  title={route.metaTitle} 
  description={route.metaDescription}
  canonicalUrl={pageUrl}
  ogImage={route.featuredImage}
  schema={routeSchemas}
  preloadImage={route.featuredImage}
>
  <Header />

  <main>
    <!-- Route Hero Section -->
    <section class="relative bg-slate-950 pt-10 pb-20 md:pb-28 px-4 sm:px-6 lg:px-8 text-white overflow-hidden">
      <!-- Background Image with Gradient Mask -->
      <div class="absolute inset-0 z-0">
        <img 
          src={route.featuredImage} 
          alt={route.destinationName} 
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover opacity-30 scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-900/60"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-transparent to-slate-950/80"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto flex flex-col items-center text-center">
        <!-- Breadcrumbs Navigation -->
        <nav class="flex items-center text-xs font-semibold text-slate-400 space-x-2 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-amber-400 transition">Home</a>
          <span>/</span>
          <a href="/transfers" class="hover:text-amber-400 transition">Transfers</a>
          <span>/</span>
          <span class="text-white font-bold">{route.destinationName}</span>
        </nav>

        <!-- Category Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-400/20 text-amber-300 text-xs font-extrabold uppercase tracking-widest mb-4 border border-amber-400/30">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Direct Cairo Airport Transfer
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight uppercase max-w-4xl leading-tight sm:leading-none mb-5 drop-shadow">
          {route.heroHeadline}
        </h1>

        <p class="text-slate-300 text-sm sm:text-base max-w-2xl font-normal mb-8 leading-relaxed">
          {route.overview}
        </p>

        <!-- Route Vital Stats Pill Bar -->
        <div class="flex flex-wrap justify-center gap-3 sm:gap-6 mb-10 text-xs sm:text-sm font-bold text-slate-200">
          <div class="flex items-center gap-2 bg-slate-900/90 px-4 py-2.5 rounded-xl border border-slate-800 shadow-md">
            <span class="text-amber-400">📍 Distance:</span>
            <span>{route.distanceKm} km</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 px-4 py-2.5 rounded-xl border border-slate-800 shadow-md">
            <span class="text-amber-400">⏱️ Est. Drive Time:</span>
            <span>{route.driveTimeMin}</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 px-4 py-2.5 rounded-xl border border-slate-800 shadow-md">
            <span class="text-amber-400">🛣️ Highway Corridor:</span>
            <span>{route.expressway}</span>
          </div>
          <div class="flex items-center gap-2 bg-amber-400 text-slate-950 px-4 py-2.5 rounded-xl shadow-md font-black">
            <span>From ${route.startingPriceUSD} / vehicle</span>
          </div>
        </div>

        <!-- Embedded Modular Booking Search Widget pre-populated with drop-off -->
        <div class="w-full">
          <BookingSearchWidget defaultDropoff={route.destinationName} />
        </div>
      </div>
    </section>

    <!-- Detailed Route & Operational Guide (High Value Travel Authority) -->
    <section class="py-14 md:py-20 bg-slate-50 border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Left: Real Route Logistics & Transit Insights -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-block text-xs font-black tracking-widest text-indigo-600 uppercase bg-indigo-50 px-3 py-1 rounded-md">
              TRAVEL LOGISTICS & ROUTE INSIGHTS
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Transfer From Cairo Airport to {route.destinationName}: Route Overview
            </h2>
            
            <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
              {route.routeDescription}
            </p>

            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
              <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="text-amber-500 text-base">🚦</span>
                Peak Rush Hour & Traffic Insights
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {route.rushHourNote}
              </p>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
              <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="text-indigo-600 text-base">🛬</span>
                Terminal Arrival & Driver Meeting Point
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {route.terminalPickupAdvice}
              </p>
              <div class="pt-2 flex flex-wrap gap-2 text-xs">
                <a href="/airports/cairo-airport-terminal-3" class="text-indigo-600 font-bold hover:underline">Terminal 3 Guide →</a>
                <span class="text-slate-300">•</span>
                <a href="/airports/cairo-airport-terminal-2" class="text-indigo-600 font-bold hover:underline">Terminal 2 Guide →</a>
                <span class="text-slate-300">•</span>
                <a href="/airports/cairo-airport-terminal-1" class="text-indigo-600 font-bold hover:underline">Terminal 1 Guide →</a>
              </div>
            </div>
          </div>

          <!-- Right: Key Landmarks & Service Inclusions Card -->
          <div class="lg:col-span-5 space-y-6">
            <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-md space-y-5">
              <h3 class="text-lg font-black text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
                <span>📍 Key Landmarks in {route.destinationName}</span>
              </h3>
              <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
                {route.landmarks.map((landmark) => (
                  <li class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shrink-0"></span>
                    <span>{landmark}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-4 border-t border-slate-100 space-y-3">
                <span class="text-[11px] font-black uppercase text-slate-400 tracking-wider block">
                  All-Inclusive Service Guarantee
                </span>
                <div class="grid grid-cols-2 gap-2 text-xs font-semibold text-slate-600">
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span> No hidden tolls
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span> Airport gate fees
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span> Free flight tracking
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span> 60m arrival wait
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-indigo-900 text-white p-6 rounded-2xl shadow-md space-y-3">
              <span class="text-xs font-black uppercase tracking-wider text-amber-300">Need Immediate Assistance?</span>
              <p class="text-xs text-indigo-100 leading-relaxed">
                Our 24/7 Cairo airport dispatch coordinators are available on WhatsApp for instant booking adjustments and vehicle dispatch.
              </p>
              <a 
                href="https://wa.me/201094066018?text=Hello%2C%20I%20need%20a%20private%20transfer%20from%20Cairo%20Airport%20to%20" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-black bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2.5 rounded-xl transition"
              >
                <span>Chat with Airport Dispatch</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Pricing Matrix Section -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/60">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
            TRANSPARENT VEHICLE RATES
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Fixed Vehicle Rates to {route.destinationName}
          </h2>
          <p class="text-slate-500 text-sm mt-2">
            No taxi meters, no toll surprises. What you see is what you pay in full per vehicle.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Standard Sedan -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50 flex flex-col justify-between hover:shadow-lg transition group">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-black uppercase text-indigo-600 tracking-wider">Economy Sedan</span>
              </div>
              <div class="w-full h-24 my-2 flex items-center justify-center">
                <img src="/images/fleet/private-taxi.webp" alt="Standard Sedan - Toyota Corolla" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mt-1">
                <a href="/fleet/private-taxi" class="hover:text-indigo-600 transition">Standard Sedan</a>
              </h3>
              <p class="text-xs text-slate-500 mt-1">Up to 3 Passengers • 2 Suitcases</p>
              <ul class="mt-4 space-y-2 text-xs text-slate-600">
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Toyota Corolla / Elantra</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Driver meets outside with sign</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Live flight radar tracking</li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-200 flex items-baseline justify-between">
              <div>
                <span class="text-[10px] text-slate-400 block uppercase font-bold">Fixed price</span>
                <span class="text-2xl font-black text-slate-900">${route.pricing.sedan}</span>
              </div>
              <a href="#search-booking" class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-sm transition">
                Book
              </a>
            </div>
          </div>

          <!-- Private Minivan -->
          <div class="p-6 rounded-2xl border-2 border-indigo-600 bg-indigo-50/30 flex flex-col justify-between relative shadow-md hover:shadow-xl transition group">
            <span class="absolute -top-3 right-4 px-2.5 py-0.5 bg-indigo-600 text-white text-[10px] font-black uppercase rounded-full shadow-sm">
              Most Popular
            </span>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-black uppercase text-indigo-600 tracking-wider">Family Choice</span>
              </div>
              <div class="w-full h-24 my-2 flex items-center justify-center">
                <img src="/images/fleet/private-minivan.webp" alt="Private Minivan - Mercedes Vito" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mt-1">
                <a href="/fleet/private-minivan" class="hover:text-indigo-600 transition">Private Minivan</a>
              </h3>
              <p class="text-xs text-slate-500 mt-1">Up to 7 Passengers • 6 Suitcases</p>
              <ul class="mt-4 space-y-2 text-xs text-slate-600">
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Toyota HiAce / Mercedes Vito</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Generous luggage compartment</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Child seats upon request</li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-indigo-200 flex items-baseline justify-between">
              <div>
                <span class="text-[10px] text-indigo-500 block uppercase font-bold">Fixed price</span>
                <span class="text-2xl font-black text-slate-900">${route.pricing.minivan}</span>
              </div>
              <a href="#search-booking" class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-sm transition">
                Book
              </a>
            </div>
          </div>

          <!-- VIP Mercedes -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50 flex flex-col justify-between hover:shadow-lg transition group">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-black uppercase text-indigo-600 tracking-wider">Executive VIP</span>
              </div>
              <div class="w-full h-24 my-2 flex items-center justify-center">
                <img src="/images/fleet/executive-vip.webp" alt="VIP Mercedes E-Class" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mt-1">
                <a href="/fleet/executive-vip" class="hover:text-indigo-600 transition">VIP Limousine</a>
              </h3>
              <p class="text-xs text-slate-500 mt-1">Up to 3 Passengers • 3 Suitcases</p>
              <ul class="mt-4 space-y-2 text-xs text-slate-600">
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Mercedes E-Class / BMW</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Onboard high-speed Wi-Fi</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Suited English chauffeur</li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-200 flex items-baseline justify-between">
              <div>
                <span class="text-[10px] text-slate-400 block uppercase font-bold">Fixed price</span>
                <span class="text-2xl font-black text-slate-900">${route.pricing.executive}</span>
              </div>
              <a href="#search-booking" class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-sm transition">
                Book
              </a>
            </div>
          </div>

          <!-- Group Minibus -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50 flex flex-col justify-between hover:shadow-lg transition group">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-black uppercase text-indigo-600 tracking-wider">Large Group</span>
              </div>
              <div class="w-full h-24 my-2 flex items-center justify-center">
                <img src="/images/fleet/airport-minibus.webp" alt="Private Minibus - Mercedes Sprinter" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 mt-1">
                <a href="/fleet/airport-minibus" class="hover:text-indigo-600 transition">Private Minibus</a>
              </h3>
              <p class="text-xs text-slate-500 mt-1">Up to 16 Passengers • 16 Suitcases</p>
              <ul class="mt-4 space-y-2 text-xs text-slate-600">
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Mercedes Sprinter / HiAce</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> High roof & dual climate control</li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-500 font-bold">✓</span> Dedicated baggage assistance</li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-200 flex items-baseline justify-between">
              <div>
                <span class="text-[10px] text-slate-400 block uppercase font-bold">Fixed price</span>
                <span class="text-2xl font-black text-slate-900">${route.pricing.minibus}</span>
              </div>
              <a href="#search-booking" class="px-4 py-2 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-xl shadow-sm transition">
                Book
              </a>
            </div>
          </div>

        </div>

        <!-- Weekly Price Feed Indicative Notice -->
        <div class="mt-8 text-center text-xs text-slate-500 bg-slate-50 border border-slate-200/80 rounded-xl py-3 px-4 max-w-2xl mx-auto flex items-center justify-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{cachedPricing.disclaimer}</span>
        </div>
      </div>
    </section>

    <!-- Key Hotels Served -->
    <section class="py-14 bg-slate-50 border-b border-slate-200/60">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 text-center mb-6">
          Popular Hotels & Resorts We Serve in {route.destinationName}
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {route.keyHotels.map((hotel) => (
            <span class="px-4 py-2 bg-white rounded-xl border border-slate-200 text-xs sm:text-sm font-semibold text-slate-800 shadow-sm flex items-center gap-2">
              <span class="text-amber-500">🏨</span>
              {hotel}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Route-Specific FAQ Section -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/60">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
            ROUTE QUESTIONS
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            Frequently Asked Questions: Cairo Airport to {route.destinationName}
          </h2>
        </div>

        <div class="space-y-4">
          {route.faqs.map((faq) => (
            <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-6 open:bg-white open:border-amber-400 open:shadow-md transition">
              <summary class="font-bold text-slate-900 text-base cursor-pointer list-none flex items-center justify-between">
                <span>{faq.q}</span>
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Pre-Footer CTA -->
    <section class="py-12 bg-slate-950 text-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-xl sm:text-2xl font-black">
            Ready to book your transfer to {route.destinationName}?
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Instant booking confirmation • Free cancellation up to 24h • 24/7 WhatsApp dispatch
          </p>
        </div>
        <a 
          href="#search-booking" 
          class="px-8 py-3.5 bg-amber-400 hover:bg-amber-500 text-slate-950 font-black text-sm rounded-xl transition shadow-lg whitespace-nowrap"
        >
          Book This Transfer
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
