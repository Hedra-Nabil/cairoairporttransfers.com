---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BookingSearchWidget from '../../components/BookingSearchWidget.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { ancillaryServices, type AncillaryService } from '../../data/ancillaries';

export async function getStaticPaths() {
  return ancillaryServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: AncillaryService;
}

const { service } = Astro.props;

const siteUrl = "https://cairoairportlimousines.com";
const pageUrl = `${siteUrl}/services/${service.slug}/`;

const otherServices = ancillaryServices.filter(s => s.slug !== service.slug);

const serviceSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": service.title,
    "description": service.shortDescription,
    "image": `${siteUrl}${service.image}`,
    "provider": {
      "@type": "LocalBusiness",
      "name": "Cairo Airport Limousine & Airport VIP Concierge",
      "telephone": "+201094066018",
      "url": `${siteUrl}/`
    },
    "areaServed": "Cairo International Airport (CAI)",
    "offers": {
      "@type": "Offer",
      "price": `${service.priceUSD}`,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${siteUrl}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Airport Services",
        "item": `${siteUrl}/services/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": service.title,
        "item": pageUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": service.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];

const encodedWhatsappMessage = encodeURIComponent(
  `Hi Cairo Airport Transfers, I would like to book the "${service.title}" (${service.arabicTitle}) at Cairo Airport. Please confirm availability and booking procedure.`
);
---

<Layout 
  title={`${service.title} | Cairo Airport Transfers`}
  description={service.metaDescription}
  canonicalUrl={pageUrl}
  ogImage={service.image}
  schema={serviceSchemas}
  preloadImage={service.image}
>
  <Header />

  <main class="bg-white">
    <!-- Hero Section -->
    <section class="relative bg-slate-950 text-white pt-10 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
      <!-- Ambient light effect -->
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-1/2 -right-24 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-6xl mx-auto space-y-6 relative z-10">
        <!-- Breadcrumbs Navigation -->
        <nav class="flex items-center text-xs font-semibold text-slate-400 space-x-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-amber-400 transition">Home</a>
          <span>/</span>
          <a href="/airports/cairo-international-airport" class="hover:text-amber-400 transition">Airport Services</a>
          <span>/</span>
          <span class="text-white font-bold">{service.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left Content -->
          <div class="lg:col-span-6 space-y-5">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${service.badgeColor}`}>
                {service.tag}
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-white/10 text-slate-300 text-xs font-bold">
                {service.arabicTitle}
              </span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
              {service.title}
            </h1>

            <p class="text-slate-300 text-base leading-relaxed">
              {service.fullDescription}
            </p>

            <!-- Price Pill -->
            <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-xs text-slate-400 block uppercase font-bold">Official Rate</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl font-black text-amber-400">${service.priceUSD}</span>
                  <span class="text-xs text-slate-400 uppercase font-semibold">USD / {service.priceUnit}</span>
                </div>
              </div>
              <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 text-xs font-bold rounded-lg border border-emerald-500/30">
                Guaranteed Availability
              </span>
            </div>

            <!-- Action CTAs -->
            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a 
                href={`https://wa.me/201094066018?text=${encodedWhatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3.5 bg-emerald-500 hover:bg-emerald-600 text-white font-black text-sm rounded-xl shadow-lg transition inline-flex items-center gap-2 transform hover:-translate-y-0.5"
              >
                <span>💬 Book Service via WhatsApp</span>
              </a>

              <a 
                href="#booking-anchor" 
                class="px-6 py-3.5 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold text-sm rounded-xl shadow-md transition"
              >
                Book with Airport Transfer
              </a>
            </div>

            <!-- Terminal badges -->
            <div class="pt-2">
              <span class="text-[11px] font-bold text-slate-400 uppercase block mb-1.5">Available At Terminals:</span>
              <div class="flex flex-wrap gap-2">
                {service.terminalsAvailable.map((t) => (
                  <span class="px-2.5 py-1 rounded-md bg-slate-800/80 border border-slate-700 text-slate-300 text-xs font-medium">
                    ✈️ {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Right Visual Presentation -->
          <div class="lg:col-span-6">
            <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl group">
              <img 
                src={service.image} 
                alt={service.alt}
                title={service.alt}
                width="800"
                height="600"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white flex justify-between items-end">
                <span class="text-xs font-bold text-slate-200">Cairo Airport Official Ancillary Service</span>
                <span class="text-sm font-black text-amber-400">${service.priceUSD} USD</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Benefits Section -->
    <section class="py-16 bg-slate-50 border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <div class="text-center max-w-2xl mx-auto">
          <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
            SERVICE HIGHLIGHTS
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Key Advantages of {service.title}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {service.benefits.map((benefit) => (
            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-start gap-3.5 hover:shadow-md transition">
              <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-black text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <p class="text-sm font-medium text-slate-800 leading-relaxed">
                {benefit}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works Step-by-Step -->
    <section class="py-16 bg-white border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="text-center max-w-2xl mx-auto">
          <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
            SEAMLESS EXPERIENCE
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            How It Works at Cairo Airport
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
          {service.howItWorks.map((step) => (
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 relative flex flex-col justify-between">
              <div class="w-12 h-12 rounded-2xl bg-amber-400 text-slate-950 flex items-center justify-center font-black text-lg shadow-sm mb-4">
                0{step.step}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Booking Search & Form -->
    <section id="booking-anchor" class="py-16 bg-slate-950 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <span class="text-xs font-black tracking-widest text-amber-400 uppercase block">
          ADD TO YOUR RIDE
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold">
          Reserve Transfer with {service.title}
        </h2>
        <p class="text-slate-300 text-sm max-w-xl mx-auto">
          Book your private airport transfer vehicle and include this service as an arrival add-on with zero hassle.
        </p>
        <div class="pt-2 text-left">
          <BookingSearchWidget />
        </div>
      </div>
    </section>

    <!-- Service FAQs -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-200/80">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
            FREQUENTLY ASKED QUESTIONS
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            Questions About {service.title}
          </h2>
        </div>

        <div class="space-y-4">
          {service.faqs.map((faq) => (
            <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-6 open:bg-white open:border-amber-400 open:shadow-md transition">
              <summary class="font-bold text-slate-900 text-base cursor-pointer list-none flex items-center justify-between">
                <span>{faq.q}</span>
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Other Airport Services -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <span class="text-xs font-black tracking-widest text-indigo-600 uppercase block mb-1">
              ADDITIONAL AIRPORT ADD-ONS
            </span>
            <h2 class="text-2xl font-black text-slate-900">
              Other Popular Cairo Airport Ancillaries
            </h2>
          </div>
          <a href="/airports/cairo-international-airport" class="text-xs font-bold text-indigo-600 hover:underline">
            View All Cairo Airport Services →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherServices.map((other) => (
            <a 
              href={`/services/${other.slug}`}
              class="group bg-white rounded-2xl p-5 border border-slate-200 hover:shadow-lg hover:border-slate-300 transition flex flex-col justify-between"
            >
              <div>
                <div class="relative h-44 w-full overflow-hidden rounded-xl bg-slate-100 mb-4">
                  <img 
                    src={other.image} 
                    alt={other.alt}
                    title={other.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class={`absolute top-2 right-2 px-2.5 py-0.5 text-[10px] font-black uppercase rounded-md shadow-sm ${other.badgeColor}`}>
                    {other.tag}
                  </span>
                </div>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition">
                  {other.title}
                </h3>
                <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                  {other.shortDescription}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-black text-slate-900">${other.priceUSD} USD</span>
                <span class="text-xs font-bold text-indigo-600 group-hover:translate-x-1 transition-transform">Learn More →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
